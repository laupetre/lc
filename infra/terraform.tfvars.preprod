# Preprod environment configuration

environment = "preprod"

# Optional: Override default values if needed
project               = "lc-swa"
location              = "eastus2"
acr_name              = "lcacrio"
openai_model          = "gpt-4o-mini"

# Note: These are provided by GitHub Actions:
